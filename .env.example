# ─────────────────────────────────────────────────────────────────────
# RecruitAI — Root .env Template for Docker Compose Local Development
# Copy this file to .env and fill in your real values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# ── Google Gemini API (Required) ─────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy_your_google_gemini_api_key_here

# ── Clerk Authentication (Required) ──────────────────────────────────
# Get your keys from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ── Clerk JWT Issuer (Required for Gateway auth validation) ───────────
# Found in Clerk Dashboard → Domains → Frontend API (e.g. https://your-app.clerk.accounts.dev)
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev

# ── Vapi.ai Voice (Optional — voice mode only) ────────────────────────
# Get from: https://dashboard.vapi.ai → Keys & Assistants
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# ── LangSmith Observability (Optional — enables agent tracing) ────────
# Get from: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=recruitai-local

# ─────────────────────────────────────────────────────────────────────
# Notes:
#   - DATABASE_URL is set automatically by docker-compose.yml
#     to postgresql://postgres:postgres@postgres:5432/recruitai
#   - For production Supabase deployment, see docs/DEPLOYMENT.md
# ─────────────────────────────────────────────────────────────────────
